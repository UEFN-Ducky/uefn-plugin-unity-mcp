{
  "id": "unity-mcp",
  "kind": "plugin",
  "version": "1.2.0",
  "label": "UNITY MCP",
  "description": "Control Unity Editor from Ducky. Runs the Coplay MCP server locally and installs MCP for Unity into open Hub projects — no Package Manager or URL setup.",
  "min_app_version": "1.0.0",
  "default_enabled": true,
  "secret_keys": [],
  "contributes": {
    "agent.tools": {
      "category": "unity",
      "intent_pattern": "\\b(unity|gameobject|prefab|unity\\s*mcp)\\b",
      "plan_tools": [
        "unity_status",
        "unity_list_tools"
      ]
    }
  },
  "backend": {
    "entry": "backend",
    "register": "register"
  }
}
